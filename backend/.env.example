DATABASE_URL=sqlite:///./onboardflow.db
API_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
MOCK_HR_USER_ID=mock-hr-user
MOCK_HR_USER_NAME=Mock HR User
ONBOARDFLOW_FLOW_MODE=deterministic
CREWAI_VERBOSE=false
CREWAI_TEMPERATURE=0.2
CREWAI_AMP_TRACING=false
# Required only when ONBOARDFLOW_FLOW_MODE=crewai
# GEMINI_API_KEY=
LLM_PROVIDER=google-gemini
LLM_MODEL=gemini-3.5-flash
LLM_PROFILE_DEFAULT_MODEL=gemini-3.5-flash
LLM_PROFILE_REASONING_MODEL=gemini-3.5-flash
LLM_PROFILE_EFFICIENT_MODEL=gemini-3.5-flash
LLM_PROFILE_CREATIVE_MODEL=gemini-3.5-flash
LLM_PROFILE_TOOL_CALLING_MODEL=gemini-3.5-flash
LLM_PROFILE_REFINEMENT_MODEL=gemini-3.5-flash
